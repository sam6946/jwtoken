# Django — generate a unique SECRET_KEY for every deployment
DJANGO_ENV=development
DJANGO_DEBUG=true
SECRET_KEY=change-me-before-deployment
JWT_SECRET=change-this-to-a-separate-random-value
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# Extra hosts (sandbox previews, internal IPs). A leading dot authorises subdomains, e.g. ".e2b.app".
EXTRA_ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Application database (compose.yml builds DATABASE_URL from these values)
POSTGRES_DB=kemta
POSTGRES_USER=kemta
POSTGRES_PASSWORD=kemta_dev_only

# Redis cache, throttling and Celery broker
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Session cookie policy. For an embedded preview (iframe) where third-party cookies are blocked,
# set SameSite=None with Secure=true and Partitioned=true (requires HTTPS).
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=Lax
REFRESH_COOKIE_PARTITIONED=false

# Phone OTP — console is development-only; production requires a configured adapter
SMS_PROVIDER=console
SMS_API_URL=
SMS_API_KEY=
OTP_TTL_SECONDS=300

# SMTP email (console backend is used only for local development)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=notifications@example.invalid
OTP_MAX_ATTEMPTS=5

# Private S3-compatible object storage (R2 / S3 / MinIO). Leave empty for local development.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_USE_SSL=true
OBJECT_STORAGE_CUSTOM_DOMAIN=

# Payments — set only after the provider account and webhook have been configured
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Security / operations
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
DJANGO_LOG_LEVEL=INFO
VITE_PORT=5173
API_PORT=8000
HTTP_PORT=80
HTTPS_PORT=443

# Behind a reverse proxy terminating TLS (preview sandbox, Nginx): trust X-Forwarded-Proto.
TRUST_PROXY_SSL_HEADER=true

# Development only: returns the refresh token in the login response so an embedded preview
# (third-party cookies blocked) can renew its session without cookies. Never enable in production.
REFRESH_TOKEN_IN_BODY=false

# Development only: accepts the access token in the neutral X-Kemta-Auth header when a preview
# proxy strips the standard Authorization header. Never enable in production.
ALLOW_TOKEN_AUTH_HEADER_FALLBACK=false
